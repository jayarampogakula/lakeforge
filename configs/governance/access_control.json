{
  "version": "1.0.0",
  "description": "Centralized Unity Catalog Access Control and Governance Configuration for LakeForge",
  "roles": {
    "data_engineers": {
      "description": "Full read/write permissions for pipeline orchestration and data engineering",
      "principals": [
        "data_engineers_group",
        "sp_lakeforge_orchestration"
      ],
      "catalogs": {
        "lakeforge_dev": ["USE CATALOG"]
      },
      "schemas": {
        "lakeforge_dev.bronze": ["USE SCHEMA", "SELECT", "MODIFY", "CREATE TABLE"],
        "lakeforge_dev.silver": ["USE SCHEMA", "SELECT", "MODIFY", "CREATE TABLE"],
        "lakeforge_dev.gold": ["USE SCHEMA", "SELECT", "MODIFY", "CREATE TABLE"]
      }
    },
    "business_analysts": {
      "description": "Read-only access to Silver cleansed tables and Gold aggregated data marts",
      "principals": [
        "business_analysts_group"
      ],
      "catalogs": {
        "lakeforge_dev": ["USE CATALOG"]
      },
      "schemas": {
        "lakeforge_dev.silver": ["USE SCHEMA"],
        "lakeforge_dev.gold": ["USE SCHEMA", "SELECT"]
      },
      "tables": {
        "lakeforge_dev.silver.customers_clean": ["SELECT"],
        "lakeforge_dev.silver.transactions_clean": ["SELECT"]
      }
    },
    "executive_viewers": {
      "description": "Access to Gold reporting views and high-level summaries only",
      "principals": [
        "executive_reporting_group"
      ],
      "catalogs": {
        "lakeforge_dev": ["USE CATALOG"]
      },
      "schemas": {
        "lakeforge_dev.gold": ["USE SCHEMA"]
      },
      "views": {
        "lakeforge_dev.gold.v_high_value_transactions": ["SELECT"],
        "lakeforge_dev.gold.v_active_customers": ["SELECT"]
      }
    },
    "compliance_auditors": {
      "description": "Read access across all layers for compliance, trust scoring, and lineage verification",
      "principals": [
        "compliance_auditors_group"
      ],
      "catalogs": {
        "lakeforge_dev": ["USE CATALOG"]
      },
      "schemas": {
        "lakeforge_dev.bronze": ["USE SCHEMA", "SELECT"],
        "lakeforge_dev.silver": ["USE SCHEMA", "SELECT"],
        "lakeforge_dev.gold": ["USE SCHEMA", "SELECT"]
      }
    }
  },
  "clients": {
    "client_alpha": {
      "description": "Tenant specific overrides and roles for client_alpha",
      "roles": {
        "alpha_analysts": {
          "principals": [
            "client_alpha_bi_group"
          ],
          "catalogs": {
            "lakeforge_client_alpha_dev": ["USE CATALOG"]
          },
          "schemas": {
            "lakeforge_client_alpha_dev.gold": ["USE SCHEMA", "SELECT"]
          }
        }
      }
    }
  },
  "masking_functions": [
    {
      "name": "mask_email",
      "schema": "silver",
      "input_column": "email",
      "input_type": "STRING",
      "return_type": "STRING",
      "expression": "CASE WHEN is_account_group_member('pii_admins') THEN email ELSE concat(substring(email, 1, 2), '****@****.com') END"
    },
    {
      "name": "mask_phone",
      "schema": "silver",
      "input_column": "phone",
      "input_type": "STRING",
      "return_type": "STRING",
      "expression": "CASE WHEN is_account_group_member('pii_admins') THEN phone ELSE concat('XXX-XXX-', substring(phone, -4)) END"
    }
  ],
  "column_masks": [
    {
      "table": "{catalog}.silver.customers_clean",
      "column": "email",
      "function": "{catalog}.silver.mask_email"
    },
    {
      "table": "{catalog}.silver.customers_clean",
      "column": "phone",
      "function": "{catalog}.silver.mask_phone"
    }
  ],
  "row_filters": [
    {
      "name": "filter_customers_by_region",
      "schema": "silver",
      "table": "{catalog}.silver.customers_clean",
      "filter_columns": ["region"],
      "expression": "is_account_group_member('global_data_access') OR region = current_user()"
    }
  ]
}
