{
  "version": "1.1.0",
  "description": "Centralized Unity Catalog Access Control and Governance Configuration for LakeForge. Catalog references are environment tokens: {catalog} resolves to the environment catalog from env_settings, {client_catalog} to the client catalog via client_catalog_pattern.",
  "roles": {
    "data_engineers": {
      "description": "Full read/write permissions for pipeline orchestration and data engineering",
      "principals": [
        "data_engineers_group",
        "sp_lakeforge_orchestration"
      ],
      "catalogs": {
        "{catalog}": ["USE CATALOG"]
      },
      "schemas": {
        "{catalog}.bronze": ["USE SCHEMA", "SELECT", "MODIFY", "CREATE TABLE"],
        "{catalog}.silver": ["USE SCHEMA", "SELECT", "MODIFY", "CREATE TABLE"],
        "{catalog}.gold": ["USE SCHEMA", "SELECT", "MODIFY", "CREATE TABLE"]
      }
    },
    "business_analysts": {
      "description": "Read-only access to Silver cleansed tables and Gold aggregated data marts",
      "principals": [
        "business_analysts_group"
      ],
      "catalogs": {
        "{catalog}": ["USE CATALOG"]
      },
      "schemas": {
        "{catalog}.silver": ["USE SCHEMA"],
        "{catalog}.gold": ["USE SCHEMA", "SELECT"]
      },
      "tables": {
        "{catalog}.silver.customers_clean": ["SELECT"],
        "{catalog}.silver.transactions_clean": ["SELECT"]
      }
    },
    "executive_viewers": {
      "description": "Access to Gold reporting views and high-level summaries only",
      "principals": [
        "executive_reporting_group"
      ],
      "catalogs": {
        "{catalog}": ["USE CATALOG"]
      },
      "schemas": {
        "{catalog}.gold": ["USE SCHEMA"]
      },
      "views": {
        "{catalog}.gold.v_high_value_transactions": ["SELECT"],
        "{catalog}.gold.v_active_customers": ["SELECT"]
      }
    },
    "compliance_auditors": {
      "description": "Read access across all layers for compliance, trust scoring, and lineage verification",
      "principals": [
        "compliance_auditors_group"
      ],
      "catalogs": {
        "{catalog}": ["USE CATALOG"]
      },
      "schemas": {
        "{catalog}.bronze": ["USE SCHEMA", "SELECT"],
        "{catalog}.silver": ["USE SCHEMA", "SELECT"],
        "{catalog}.gold": ["USE SCHEMA", "SELECT"]
      }
    }
  }
}
